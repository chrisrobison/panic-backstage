<FilesMatch "^(?!(?:ops-manual|event-intake-status|contracts|public-calendar-api|promote-guide|training|sales|booking-inbox|booking-inbox-guide)\.html$).+">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
