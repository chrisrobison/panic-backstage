			message: '#^Offset ''date'' on array\{external_id\: ''A'', referral_source\: ''B'', promoter_name\: ''C'', title\: ''D'', date\: ''E'', potential_revenue\: ''F'', capacity\: ''K'', room\: ''L'', \.\.\.\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
