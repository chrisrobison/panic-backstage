# ── Single-tenant mode ────────────────────────────────────────────────────────
# Used when SUPER_DB_NAME is NOT set. This is the original standalone install
# configuration — all existing deploys use only these vars.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=panic_backstage
APP_BASE_PATH=
APP_URL=http://localhost
JWT_SECRET=generate-with-openssl-rand-hex-48
# Browser access tokens are deliberately short lived; refresh tokens rotate
# in HttpOnly cookies. Allowed range: 300-3600 seconds.
ACCESS_TOKEN_TTL_SECONDS=900

# ── Credential encryption ─────────────────────────────────────────────────────
# 64-character hex string (32 bytes) used to encrypt Promote OAuth tokens
# and API keys at rest using libsodium secretbox (XSalsa20-Poly1305).
# Required for the encryption feature; app runs without it but tokens are
# stored in plaintext (dev/legacy mode).
#
# Generate with: php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
# After generating, run: php scripts/encrypt-credentials.php
#
# Key rotation: add CREDENTIAL_ENCRYPTION_KEY_NEW=<new-hex> then run:
#   php scripts/rotate-credential-keys.php
# After successful rotation, move NEW to CREDENTIAL_ENCRYPTION_KEY.
CREDENTIAL_ENCRYPTION_KEY=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Backstage

# ── Venue identity ────────────────────────────────────────────────────────────
# These values are used throughout the app wherever a venue name or contact is
# needed: email subjects, social-media copy, promote sign-offs, address fallbacks.
#
# In single-tenant mode, set these here.
# In multi-tenant (SaaS) mode, place overrides in clients/{slug}/.env so each
# tenant gets its own values without touching the shared global config.
#
VENUE_NAME=My Venue
# Public-facing contact email (used as From address for promote email blasts)
VENUE_EMAIL=hello@myvenue.com
# Website URL shown in copy and press releases
VENUE_WEBSITE=https://myvenue.com
# City and state — used as address fallback in Luma / Eventbrite submissions
VENUE_CITY=
VENUE_STATE=
# Press / media contact email for press release copy
VENUE_PRESS_EMAIL=press@myvenue.com
# Comma-separated hashtags (no #) for social-media copy.
# Example: LiveMusic,MyVenue,SFMusic,BayAreaMusic
VENUE_HASHTAGS=LiveMusic
# TikTok handle (without @) — used to build post URLs after broadcasting.
# Also configurable per-venue in Promote Settings → TikTok → handle field.
VENUE_TIKTOK_HANDLE=

# ── Multi-tenant SaaS mode ────────────────────────────────────────────────────
# Set SUPER_DB_NAME to enable multi-tenant routing via HTTP_HOST.
# Leave blank (or omit) to keep standard single-tenant behaviour.
#
# When active, every request to XXX.panicbackstage.com is resolved against the
# super registry and routed to the XXX tenant database. The DB_* vars above are
# ignored in SaaS mode.
#
# Super-admin registry database (stores tenants + tenant_domains tables).
SUPER_DB_NAME=
SUPER_DB_HOST=127.0.0.1
SUPER_DB_PORT=3306
SUPER_DB_USER=root
SUPER_DB_PASSWORD=
#
# Runtime tenant connections — needs SELECT/INSERT/UPDATE/DELETE on panic_backstage_*.
# Falls back to SUPER_DB_* if left blank (convenient for single-server dev installs).
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USER=
TENANT_DB_PASSWORD=
#
# Provisioning credentials — needs CREATE DATABASE + DDL on panic_backstage_*.
# Used by scripts/migrate.php and TenantProvisioner when creating new tenants.
# Falls back to SUPER_DB_* if PROVISION_DB_USER is blank.
PROVISION_DB_HOST=127.0.0.1
PROVISION_DB_PORT=3306
PROVISION_DB_USER=
PROVISION_DB_PASSWORD=
#
# Hostname allow-list (comma-separated). Supports *.domain.com wildcard prefix.
ALLOWED_HOSTS=localhost,127.0.0.1,panicbackstage.com,*.panicbackstage.com
#
# Set to true when the app sits behind a reverse proxy that sets X-Forwarded-Host.
TRUST_PROXY=false
#
# Support login (customer-support "log into any tenant as a site admin"):
# when true, AuthEndpoint::login() falls back to checking super_admin_users
# after a normal tenant-user login attempt fails, so a platform super admin's
# own credentials work as a site-admin login on every tenant. Fleet-wide
# kill switch — leave unset/false to disable the whole feature without a
# deploy. See src/SupportLogin.php and database/migrations/060_support_login.sql.
SUPPORT_LOGIN_ENABLED=
#
# Optional: restrict /super and /api/super to this hostname only.
# When blank, those paths are served from any allowed host (legacy behaviour).
SUPER_HOST=

# ── Private event workflow ────────────────────────────────────────────────────
# New private events are auto-assigned to this user (by DB user ID) and trigger
# an inquiry notification to all venue_admins. Defaults to the first venue_admin
# if unset.
PRIVATE_EVENT_HANDLER_USER_ID=
PRIVATE_EVENT_HANDLER_EMAIL=

# ── Intake Complete notifications ─────────────────────────────────────────────
# When any event reaches Intake Complete, this person is notified alongside the
# venue_admins so they can co-sign and send the contract. Typically the venue
# manager who reviews and countersigns all contracts before they go to the artist.
#
# This trio, plus VENUE_EMAIL/VENUE_PRESS_EMAIL/VENUE_HASHTAGS/VENUE_TIKTOK_HANDLE
# above, is editable from the app itself at Admin > App Settings (no server
# access needed) — see src/AppSettings.php. VENUE_NAME/CITY/STATE/WEBSITE are
# intentionally NOT part of that page; they're DB-backed at Admin > Venue
# instead, so there's exactly one place to edit the venue's name/address.
VENUE_MANAGER_NAME=
VENUE_MANAGER_EMAIL=
VENUE_MANAGER_PHONE=

# ─── Digital signature ────────────────────────────────────────────────────────
# Provider to use for contract e-signatures.
#   internal     — magic-link flow built into Panic Backstage (default; no external service)
#   mock         — dev/test simulator; no external calls
#   dropbox_sign — Dropbox Sign REST API (needs SIGNATURE_PROVIDER_API_KEY)
#   docusign     — not yet implemented
SIGNATURE_PROVIDER=internal

# How long (in hours) a signing link remains valid before it expires.
# Default: 168 hours (7 days).
SIGNATURE_TOKEN_TTL_HOURS=168

# Webhook signing secret — verifies inbound webhooks came from the provider.
# Dropbox Sign: the "Event Callback" secret from the API dashboard.
SIGNATURE_WEBHOOK_SECRET=

# External provider API credentials (only needed for dropbox_sign/docusign).
SIGNATURE_PROVIDER_API_KEY=
SIGNATURE_PROVIDER_CLIENT_ID=
SIGNATURE_PROVIDER_CLIENT_SECRET=
# Override the provider API base URL (leave blank to use production default).
SIGNATURE_PROVIDER_BASE_URL=

# ─── Ticketing / payment providers ───────────────────────────────────────────
# The active provider is selected at runtime in the payment_settings table; the
# keys below are the (secret) credentials each provider needs. Only the active
# provider's keys must be populated, but webhooks/refunds for historical orders
# use whichever provider processed them, so keep keys for any provider you've
# ever taken payments with.

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=your_stripe_secret_key
# Endpoint signing secret from the Stripe webhook settings (starts with whsec_)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# Square (https://developer.squareup.com/apps)
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_LOCATION_ID=your_square_location_id
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key
# 'sandbox' or 'production' — switches the Square API base URL
SQUARE_ENV=sandbox
# Exact notification URL configured in the Square webhook subscription; used to
# verify the x-square-hmacsha256-signature. If unset, the live request URL is
# used as a best-effort fallback.
SQUARE_WEBHOOK_URL=https://yourdomain.com/api/webhooks/square

# Square POS (bar/merch point-of-sale) — separate from the ticketing webhook above.
# Create a second webhook subscription in the Square Developer Dashboard pointing
# to the URL below; the signing secret for that subscription goes in
# SQUARE_POS_WEBHOOK_SECRET.  If you use a single signing secret for both
# subscriptions you may leave SQUARE_POS_WEBHOOK_SECRET blank — the handler
# falls back to SQUARE_WEBHOOK_SIGNATURE_KEY automatically.
SQUARE_POS_WEBHOOK_SECRET=
SQUARE_POS_WEBHOOK_URL=https://yourdomain.com/api/webhooks/square-pos

# ── Accounting integration (QuickBooks Online or Xero) ───────────────────────
# Set accounting_provider in the promote_settings row to 'qbo' or 'xero' to
# enable post-closeout journal sync. Both providers use OAuth 2.0 refresh tokens;
# obtain these from the respective developer consoles and paste them below.
#
# QuickBooks Online (https://developer.intuit.com)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=
#
# Xero (https://developer.xero.com)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REFRESH_TOKEN=
XERO_TENANT_ID=

# ── X (Twitter) OAuth 2.0 ──────────────────────────────────────────────────────
# Enables the in-app "Connect X account" button under Settings → Promote → X
# (Panic\Promote\TwitterOAuth) — a full PKCE authorization-code flow, no manual
# Postman/curl steps required. Without these set, the X card still works via
# manually-pasted access/refresh tokens (see TwitterAdapter.php docblock).
#
# Setup:
#   1. developer.twitter.com → create a Project + App.
#   2. App Settings → User Authentication Settings:
#        - Type of App: Web App / Automated App
#        - App permissions: Read and write
#        - Redirect URI: {APP_URL}/api/promote/oauth/twitter/callback
#   3. Keys and Tokens → OAuth 2.0 Client ID and Client Secret: paste below.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ── CRM follow-up reminders ───────────────────────────────────────────────────
# Random secret for the /api/crm-followups cron endpoint.
# Generate: openssl rand -hex 24
# Call daily: curl -X POST -H "X-Cron-Secret: $CRON_SECRET" https://yourdomain.com/api/crm-followups
CRON_SECRET=

# ── Booking-email importer ────────────────────────────────────────────────────
# scripts/ingest-booking-email.php turns inbound emails (forwarded to
# bookings@themab.org and piped in by an Exim filter) into `leads` rows. The
# Booking Inbox's AI classification (src/Leads/Classifier.php) runs right
# after it, against the same message.
#
# Structured (Jotform) and labelled emails parse deterministically with no AI
# call. Freeform prose is extracted with Claude, and inbox classification
# runs, through the LOCAL `claude` CLI (OAuth-authenticated already — no
# ANTHROPIC_API_KEY, no billed API usage; see CLAUDE_CLI_BIN below and
# src/Ai/ClaudeCli.php), falling back to regex heuristics / no classification
# when that CLI isn't available — so the importer still works without it,
# just less richly on freeform messages.
#
# Requires this script to run as the same OS user that ran `claude login`
# (true by default here: Exim invokes it as the mailbox owner via
# ~/.forward) — a different user will find the binary but fail to
# authenticate, and silently fall back the same as if it weren't installed.
#
# Model alias/name used for freeform extraction + classification (default: opus).
LEAD_PARSER_MODEL=opus
# Optional: override the importer log file (default storage/logs/booking-intake.log).
# BOOKING_INTAKE_LOG=

# ── Assets Approved: linktree/Instagram notification (issue #14) ─────────────
# When an event reaches Assets Approved, this person gets a dedicated email
# with the full promo packet (poster, description, ticket link) — separate
# from the generic venue_admin status-changed notice. Defaults to Molly's
# address if unset.
LINKTREE_MANAGER_NAME=
LINKTREE_MANAGER_EMAIL=

# ── AI Assistant drawer (venue_admin only) ────────────────────────────────────
# Runs entirely through the LOCAL `claude` CLI (OAuth-authenticated already —
# no ANTHROPIC_API_KEY, no billed API usage). See src/Ai/Assistant.php and
# docs/AI-ASSISTANT-PLAN.md.
#
# CLAUDE_CLI_BIN below is shared with every other Claude-backed feature in
# this app (src/Ai/ClaudeCli.php — the Booking Inbox's AI classification and
# the booking-email importer's freeform extraction, see "Booking-email
# importer" above) — they all ride the same local OAuth session rather than
# each needing their own credential.
#
# Absolute path to the `claude` binary on this box.
CLAUDE_CLI_BIN=/home/cdr/.local/bin/claude
# Home directory of the OS user that ran `claude login` (where
# ~/.claude/.credentials.json actually lives). Every spawn of the CLI pins
# HOME to this explicitly rather than trusting the calling process's own —
# when a request is served through PHP-FPM (pool user e.g. www-data), that
# worker's real home isn't /home/cdr, so without this override the CLI's
# os.homedir() fallback resolves to the *pool user's* home (nothing there)
# and silently authenticates as nobody instead of loudly failing. The pool
# user also needs read access to ~/.claude/.credentials.json itself (e.g.
# via shared group membership + chmod g+r) — a HOME override alone isn't
# sufficient if the file still isn't readable.
CLAUDE_CLI_HOME=/home/cdr
# Model alias passed to `claude --model`.
AI_ASSISTANT_MODEL=sonnet
# Hard per-request timeout (seconds) — the subprocess is force-killed
# (SIGKILL via `timeout`) past this, never left to hang the web worker.
AI_ASSISTANT_TIMEOUT_SECONDS=60
# Optional: caps `claude --max-budget-usd` per request. Leave blank for no cap
# (the real cost risk here is "noisy neighbor" usage against the shared
# subscription quota, not a dollar bill — see the plan doc).
AI_ASSISTANT_MAX_BUDGET_USD=

# ── Hold auto-expiration (issue #17) ──────────────────────────────────────────
# scripts/expire-holds.php / scripts/cron-expire-holds.sh auto-cancel a Hold
# that's sat on the calendar 14 days with no movement, warning 48h ahead of
# time. The cron entry is installed but the script no-ops until this is set —
# see the script's header comment for the required --reset-baseline step
# that MUST be run once, by hand, before ever enabling this (skipping it
# would mass-cancel every pre-existing stale Hold in one pass).
HOLD_EXPIRY_ENABLED=
